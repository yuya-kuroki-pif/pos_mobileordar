# ---------------------------------------------------------------------------
# Supabase 接続情報
# Supabase ダッシュボード > Project Settings > API から取得してください。
# 実際の値は .env.local にコピーして記入します（.env.local は git 管理外）。
# ---------------------------------------------------------------------------

# プロジェクト URL（例: https://xxxxxxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# 公開可能キー（anon / publishable key）。ブラウザに露出して構わないキー。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サービスロールキー。★絶対にクライアントへ露出させないこと★
# サーバー側（API Route / Server Component）からのみ使用します。
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# アプリ設定
# ---------------------------------------------------------------------------

# スタッフ用セッション Cookie の署名に使う秘密鍵。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# QR コードに埋め込む公開 URL（本番は https://your-domain.com）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# メニューアシスタント（/menuAssistant）
# 未設定でもアプリは動きます。その場合この画面だけが使えません。
# ---------------------------------------------------------------------------

# Anthropic API キー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=

# 使うモデル。省略時は claude-sonnet-5
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# メッセージ配信（任意）
# 未設定でも配信の予約は作れます。設定すると試し送りができるようになります。
# ---------------------------------------------------------------------------

# LINE Messaging API のチャネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=

# Zalo Official Account の access token
ZALO_OA_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Google ビジネスプロフィール（任意・未接続）
# クチコミの取り込みと返信の投稿に使います。
# ---------------------------------------------------------------------------
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Zalo ログイン連携（任意）
# モバイルオーダーを開いたお客様を Zalo で特定するのに使います。
# 未設定でも注文はできます（連携画面に「準備中」と出ます）。
# Zalo Developers でアプリを登録して取得します。
# ---------------------------------------------------------------------------
ZALO_APP_ID=
ZALO_APP_SECRET=
